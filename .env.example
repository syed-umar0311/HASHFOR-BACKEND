# HASHFOR_AGENTS environment — copy to .env and fill in.

# ---------- Required ----------
# Used by every agent (GitHub on-page/technical and Shopify/WordPress) to generate fixes.
OPENAI_API_KEY=

# Frontend origins allowed to call this API from the browser (comma-separated).
# The GitHub /run endpoint is called from the browser, so the live site must be listed.
ALLOWED_ORIGINS=http://localhost:3000,https://www.hashfor.com,https://hashfor.com

# ---------- Shopify / WordPress auto-push (/run/cms) ----------
# Shared secret: the Hashfor app sends it as X-Agent-Key. Must equal AGENT_API_KEY in hashfor/.env.
# Leave empty to disable the check (not recommended in production).
AGENT_API_KEY=

# Shopify Admin API version used for auto-push. Use a version your Shopify app supports.
SHOPIFY_API_VERSION=2025-10

# ---------- Server ----------
# Render sets PORT automatically; 7860 is the local default.
PORT=7860

# ---------- Only for running `python orchestrator.py` from the command line ----------
# The API (/run) passes these per request, so the server does not need them.
# GITHUB_TOKEN=
# REPO_URL=https://github.com/you/yoursite
# BRANCH=main
# SITE_BASE=https://yoursite.com
# CSV_PATH=seo_report.csv
# GIT_USERNAME=SEO-Auto-Fix-Bot
# GIT_EMAIL=seo-bot@example.com
# AGENTS=onpage,technical
# LOCALES=
